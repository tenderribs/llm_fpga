# Non-project Vivado build. Runs one stage per invocation and picks up from the
# previous stage's checkpoint. All output goes to build/<top>/.
#
# Normally run through the Makefile, which decides which stages need rerunning.
# To run a stage by hand, from the repo root:
#   source /tools/Xilinx/2026.1/Vivado/settings64.sh
#   mkdir -p build/top_qmv
#   vivado -mode batch -nojournal -log build/top_qmv/synth.log -source scripts/build.tcl -tclargs synth top_qmv

set repo_root [file normalize [file dirname [info script]]/..]
set srcs_dir  $repo_root/src
set part      xc7k325tffg900-2

set stage [lindex $argv 0]
set top   [lindex $argv 1]
set out_dir $repo_root/build/$top

# Open the board's FPGA in the hardware manager and return it. The board's JTAG
# chip shows up as two targets, and only one has the FPGA on its chain; their
# order varies, so try each.
proc open_fpga {} {
    open_hw_manager
    connect_hw_server
    set dev ""
    foreach t [get_hw_targets] {
        catch {close_hw_target}
        if {[catch {open_hw_target -quiet $t}]} continue
        set dev [lindex [get_hw_devices -quiet xc7k325t*] 0]
        if {$dev ne ""} break
    }
    if {$dev eq ""} {
        error "No xc7k325t found on any JTAG target: [get_hw_targets]"
    }
    current_hw_device $dev
    return $dev
}

# Each stage writes its checkpoint last. Make treats that file as proof the stage
# finished, so a stage that fails partway through runs again next time.
switch $stage {
    synth {
        # Only design sources belong here
        read_verilog -sv [glob $srcs_dir/sources/*.sv]
        read_xdc $srcs_dir/constrs/genesys2.xdc
        if {$top in {top_llm top_soc}} {
            # DDR controller, generated and synthesized on its own by
            # scripts/gen_ip.tcl (make ip). Its checkpoint is linked in here
            # and brings its own pin and clock constraints.
            read_ip $repo_root/build/ip/mig_ddr3/mig_ddr3.xci
            read_xdc $srcs_dir/constrs/top_llm.xdc
            if {$top eq "top_soc"} {
                # CPU subsystem, generated by scripts/gen_cpu.tcl (make cpu)
                read_bd $repo_root/build/cpu_bd/cpu_bd.srcs/sources_1/bd/cpu/cpu.bd
            }
        } else {
            read_xdc $srcs_dir/constrs/sysclk.xdc
        }

        # Synthesis: RTL to a netlist of FPGA primitives. Timing here is only an
        # estimate because nothing has been placed or routed yet.
        synth_design -top $top -part $part
        report_utilization -file $out_dir/post_synth_utilization.rpt
        report_timing_summary -file $out_dir/post_synth_timing.rpt
        write_checkpoint -force $out_dir/post_synth.dcp
    }
    impl {
        # Implementation: fit the netlist onto the physical device. The checkpoint
        # carries the constraints, so the XDC is not read again here.
        open_checkpoint $out_dir/post_synth.dcp
        opt_design
        place_design
        phys_opt_design
        route_design
        report_utilization -file $out_dir/post_route_utilization.rpt
        report_timing_summary -file $out_dir/post_route_timing.rpt
        report_drc -file $out_dir/post_route_drc.rpt

        # route_design succeeds even when timing fails, so check it explicitly.
        set wns [get_property SLACK [get_timing_paths -setup]]
        if {$wns < 0} {
            puts "WARNING: timing not met, WNS = $wns ns. See $out_dir/post_route_timing.rpt"
        } else {
            puts "Timing met, WNS = $wns ns"
        }

        write_checkpoint -force $out_dir/post_route.dcp
    }
    bit {
        open_checkpoint $out_dir/post_route.dcp
        write_bitstream -force $out_dir/$top.bit
        if {$top eq "top_soc"} {
            # where the CPU's local memory sits in the bitstream, so firmware
            # can be put into it later with updatemem
            write_mem_info -force $out_dir/$top.mmi
        }
    }
    program {
        # Load a bitstream over the board's JTAG USB port (argv 2, default
        # build/<top>/<top>.bit). The design is lost at power-off; this does
        # not write the flash.
        set bit [lindex $argv 2]
        if {$bit eq ""} { set bit $out_dir/$top.bit }
        set dev [open_fpga]
        set_property PROGRAM.FILE $bit $dev
        program_hw_devices $dev
        close_hw_manager
    }
    flash {
        # Write a bitstream (argv 2) to the board's quad-SPI flash, then have
        # the FPGA configure itself from it. The board boots from the flash
        # at power-on when its mode jumper is set to QSPI. This overwrites
        # whatever the flash held.
        set bit [lindex $argv 2]
        set mcs [file rootname $bit].mcs
        write_cfgmem -force -format mcs -size 32 -interface SPIx4 \
            -loadbit "up 0x00000000 $bit" -file $mcs
        set dev [open_fpga]
        # Genesys 2: Spansion S25FL256S (FLASH_PART overrides)
        set part_name s25fl256sxxxxxx0-spi-x1_x2_x4
        if {[info exists ::env(FLASH_PART)]} { set part_name $::env(FLASH_PART) }
        create_hw_cfgmem -hw_device $dev [lindex [get_cfgmem_parts $part_name] 0]
        set cm [get_property PROGRAM.HW_CFGMEM $dev]
        set_property PROGRAM.ADDRESS_RANGE {use_file} $cm
        set_property PROGRAM.FILES [list $mcs] $cm
        set_property PROGRAM.UNUSED_PIN_TERMINATION {pull-none} $cm
        set_property PROGRAM.BLANK_CHECK 0 $cm
        set_property PROGRAM.ERASE 1 $cm
        set_property PROGRAM.CFG_PROGRAM 1 $cm
        set_property PROGRAM.VERIFY 1 $cm
        set_property PROGRAM.CHECKSUM 0 $cm
        # the FPGA gets a helper design that drives the flash for Vivado
        create_hw_bitstream -hw_device $dev [get_property PROGRAM.HW_CFGMEM_BITFILE $dev]
        program_hw_devices $dev
        refresh_hw_device $dev
        program_hw_cfgmem -hw_cfgmem $cm
        boot_hw_device $dev
        close_hw_manager
    }
    default {
        error "Unknown stage '$stage': use synth, impl, bit, program or flash"
    }
}
